{
  "entities": {
    "UserAccount": {
      "title": "UserAccount",
      "description": "Private Daymark user profile and daily tracker settings stored per authenticated user.",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$",
          "description": "Authenticated Firebase user UID."
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80,
          "description": "Display name shown in dashboard greetings."
        },
        "role": {
          "type": "string",
          "maxLength": 80,
          "description": "User role or daily focus headline."
        },
        "focusPillar": {
          "type": "string",
          "enum": [
            "Work & Projects",
            "Study & Learning",
            "Health & Routine",
            "Financial Discipline"
          ],
          "description": "Primary personal focus category."
        },
        "dailyFocusTargetMinutes": {
          "type": "number",
          "description": "Daily focused work target in minutes (15 to 720)."
        },
        "avatarStyle": {
          "type": "string",
          "enum": ["art", "monogram", "photo"],
          "description": "Selected avatar display style."
        },
        "avatarColor": {
          "type": "string",
          "maxLength": 16,
          "pattern": "^#[0-9a-fA-F]{6}$",
          "description": "Hex accent color for monogram avatar."
        },
        "onboardingCompleted": {
          "type": "boolean",
          "description": "Whether initial profile setup has been completed."
        },
        "themeMode": {
          "type": "string",
          "enum": ["light", "dark", "system"],
          "description": "Preferred color theme."
        },
        "currencySymbol": {
          "type": "string",
          "minLength": 1,
          "maxLength": 6,
          "description": "Display currency symbol for expenses."
        },
        "dailyBudgetCap": {
          "type": "number",
          "description": "Target daily spending cap."
        },
        "budgetWarningPercent": {
          "type": "number",
          "description": "Percentage threshold for early budget warnings."
        },
        "dailyGoalSuccessThreshold": {
          "type": "number",
          "description": "Minimum daily average goal percentage required for streak credit."
        },
        "notificationsEnabled": {
          "type": "boolean",
          "description": "Whether scheduled reminders are enabled."
        },
        "morningReminderTime": {
          "type": "string",
          "maxLength": 5,
          "pattern": "^[0-2][0-9]:[0-5][0-9]$",
          "description": "Daily morning check-in time (HH:mm)."
        },
        "eveningReminderTime": {
          "type": "string",
          "maxLength": 5,
          "pattern": "^[0-2][0-9]:[0-5][0-9]$",
          "description": "Daily evening unfinished-goal alert time (HH:mm)."
        },
        "celebrateMilestones": {
          "type": "boolean",
          "description": "Whether instant 100% milestone alerts are active."
        },
        "budgetWarningsEnabled": {
          "type": "boolean",
          "description": "Whether daily budget limit alerts are active."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp of account creation."
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp of last update."
        }
      },
      "required": [
        "uid",
        "name",
        "role",
        "focusPillar",
        "dailyFocusTargetMinutes",
        "avatarStyle",
        "avatarColor",
        "onboardingCompleted",
        "themeMode",
        "currencySymbol",
        "dailyBudgetCap",
        "budgetWarningPercent",
        "dailyGoalSuccessThreshold",
        "notificationsEnabled",
        "morningReminderTime",
        "eveningReminderTime",
        "celebrateMilestones",
        "budgetWarningsEnabled",
        "createdAt",
        "updatedAt"
      ]
    },
    "DailyGoalDoc": {
      "title": "DailyGoalDoc",
      "description": "Personal daily target goal tracked via slider, unit counter, weighted checklist, or timer.",
      "type": "object",
      "properties": {
        "ownerId": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "dateKey": {
          "type": "string",
          "maxLength": 10,
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 140
        },
        "category": {
          "type": "string",
          "enum": ["Work", "Study", "Health", "Personal", "Finance"]
        },
        "trackingMode": {
          "type": "string",
          "enum": ["slider", "counter", "checklist", "timer"]
        },
        "progressPercent": {
          "type": "number"
        },
        "currentValue": {
          "type": "number"
        },
        "targetValue": {
          "type": "number"
        },
        "unitLabel": {
          "type": "string",
          "maxLength": 24
        },
        "targetMinutes": {
          "type": "number"
        },
        "loggedMinutes": {
          "type": "number"
        },
        "subtasks": {
          "type": "array",
          "description": "Bounded list of up to 25 weighted sub-task maps."
        },
        "reminderTime": {
          "type": "string",
          "maxLength": 5
        },
        "completedAt": {
          "type": "string",
          "maxLength": 40
        },
        "milestoneNotified": {
          "type": "boolean"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "ownerId",
        "dateKey",
        "title",
        "category",
        "trackingMode",
        "progressPercent",
        "currentValue",
        "targetValue",
        "unitLabel",
        "targetMinutes",
        "loggedMinutes",
        "subtasks",
        "milestoneNotified",
        "createdAt",
        "updatedAt"
      ]
    },
    "WorkSessionDoc": {
      "title": "WorkSessionDoc",
      "description": "Logged Pomodoro, deep work, or custom focused work block.",
      "type": "object",
      "properties": {
        "ownerId": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "dateKey": {
          "type": "string",
          "maxLength": 10,
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
        },
        "goalId": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "goalTitle": {
          "type": "string",
          "minLength": 1,
          "maxLength": 140
        },
        "mode": {
          "type": "string",
          "enum": ["pomodoro", "deep", "custom"]
        },
        "durationMinutes": {
          "type": "number"
        },
        "startedAt": {
          "type": "string",
          "maxLength": 40
        },
        "endedAt": {
          "type": "string",
          "maxLength": 40
        },
        "note": {
          "type": "string",
          "maxLength": 240
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "ownerId",
        "dateKey",
        "goalId",
        "goalTitle",
        "mode",
        "durationMinutes",
        "startedAt",
        "endedAt",
        "createdAt"
      ]
    },
    "ExpenseEntryDoc": {
      "title": "ExpenseEntryDoc",
      "description": "Daily expense entry monitored against the user's daily budget cap.",
      "type": "object",
      "properties": {
        "ownerId": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "dateKey": {
          "type": "string",
          "maxLength": 10,
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
        },
        "amount": {
          "type": "number"
        },
        "category": {
          "type": "string",
          "enum": ["Food", "Transport", "Work", "Bills", "Health", "Personal"]
        },
        "note": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "ownerId",
        "dateKey",
        "amount",
        "category",
        "note",
        "createdAt",
        "updatedAt"
      ]
    },
    "NotificationDoc": {
      "title": "NotificationDoc",
      "description": "Triggered daily reminder, milestone celebration, or budget cap alert.",
      "type": "object",
      "properties": {
        "ownerId": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "type": {
          "type": "string",
          "enum": ["reminder", "milestone", "budget_warning", "budget_exceeded", "timer"]
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "body": {
          "type": "string",
          "minLength": 1,
          "maxLength": 320
        },
        "read": {
          "type": "boolean"
        },
        "triggeredAt": {
          "type": "string",
          "maxLength": 40
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "ownerId",
        "type",
        "title",
        "body",
        "read",
        "triggeredAt",
        "createdAt",
        "updatedAt"
      ]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": { "$ref": "#/entities/UserAccount" },
      "description": "Private user profile and app preferences document."
    },
    "/users/{userId}/goals/{goalId}": {
      "schema": { "$ref": "#/entities/DailyGoalDoc" },
      "description": "User's personal daily target goals."
    },
    "/users/{userId}/sessions/{sessionId}": {
      "schema": { "$ref": "#/entities/WorkSessionDoc" },
      "description": "User's logged Pomodoro and focused work sessions."
    },
    "/users/{userId}/expenses/{expenseId}": {
      "schema": { "$ref": "#/entities/ExpenseEntryDoc" },
      "description": "User's daily expense records."
    },
    "/users/{userId}/notifications/{notificationId}": {
      "schema": { "$ref": "#/entities/NotificationDoc" },
      "description": "User's alert and reminder history."
    }
  }
}
