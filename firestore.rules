rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Global Safety Net (Default Deny)
    match /{document=**} {
      allow read, write: if false;
    }

    // --- Phase 3: Hardened Global Primitives ---
    function isSignedIn() {
      return request.auth != null;
    }

    function isVerifiedUser() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isVerifiedOwner(userId) {
      return isVerifiedUser() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isValidDateKey(val) {
      return val is string && val.size() == 10 && val.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$');
    }

    function isValidTimeHHMM(val) {
      return val is string && val.size() == 5 && val.matches('^[0-2][0-9]:[0-5][0-9]$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function parentUserExists(userId) {
      return exists(/databases/$(database)/documents/users/$(userId));
    }

    // --- Validation Blueprints (Pillar 2 & Pillar 5) ---
    function isValidUserAccount(data, userId) {
      return data.keys().hasAll([
        'uid',
        'name',
        'role',
        'focusPillar',
        'dailyFocusTargetMinutes',
        'avatarStyle',
        'avatarColor',
        'onboardingCompleted',
        'themeMode',
        'currencySymbol',
        'dailyBudgetCap',
        'budgetWarningPercent',
        'dailyGoalSuccessThreshold',
        'notificationsEnabled',
        'morningReminderTime',
        'eveningReminderTime',
        'celebrateMilestones',
        'budgetWarningsEnabled',
        'createdAt',
        'updatedAt'
      ]) &&
      data.keys().hasOnly([
        'uid',
        'name',
        'role',
        'focusPillar',
        'dailyFocusTargetMinutes',
        'avatarStyle',
        'avatarColor',
        'onboardingCompleted',
        'themeMode',
        'currencySymbol',
        'dailyBudgetCap',
        'budgetWarningPercent',
        'dailyGoalSuccessThreshold',
        'notificationsEnabled',
        'morningReminderTime',
        'eveningReminderTime',
        'celebrateMilestones',
        'budgetWarningsEnabled',
        'createdAt',
        'updatedAt'
      ]) &&
      data.uid is string && data.uid == request.auth.uid && data.uid == userId && isValidId(data.uid) &&
      data.name is string && data.name.size() >= 1 && data.name.size() <= 80 &&
      data.role is string && data.role.size() <= 80 &&
      data.focusPillar in ['Work & Projects', 'Study & Learning', 'Health & Routine', 'Financial Discipline'] &&
      data.dailyFocusTargetMinutes is number && data.dailyFocusTargetMinutes >= 15 && data.dailyFocusTargetMinutes <= 720 &&
      data.avatarStyle in ['art', 'monogram', 'photo'] &&
      data.avatarColor is string && data.avatarColor.size() == 7 && data.avatarColor.matches('^#[0-9a-fA-F]{6}$') &&
      data.onboardingCompleted is bool &&
      data.themeMode in ['light', 'dark', 'system'] &&
      data.currencySymbol is string && data.currencySymbol.size() >= 1 && data.currencySymbol.size() <= 6 &&
      data.dailyBudgetCap is number && data.dailyBudgetCap >= 1 && data.dailyBudgetCap <= 10000000 &&
      data.budgetWarningPercent is number && data.budgetWarningPercent >= 50 && data.budgetWarningPercent <= 100 &&
      data.dailyGoalSuccessThreshold is number && data.dailyGoalSuccessThreshold >= 10 && data.dailyGoalSuccessThreshold <= 100 &&
      data.notificationsEnabled is bool &&
      isValidTimeHHMM(data.morningReminderTime) &&
      isValidTimeHHMM(data.eveningReminderTime) &&
      data.celebrateMilestones is bool &&
      data.budgetWarningsEnabled is bool &&
      data.createdAt is timestamp &&
      data.updatedAt is timestamp;
    }

    function isValidGoal(data, userId) {
      return data.keys().hasAll([
        'ownerId',
        'dateKey',
        'title',
        'category',
        'trackingMode',
        'progressPercent',
        'currentValue',
        'targetValue',
        'unitLabel',
        'targetMinutes',
        'loggedMinutes',
        'subtasks',
        'milestoneNotified',
        'createdAt',
        'updatedAt'
      ]) &&
      data.keys().hasOnly([
        'ownerId',
        'dateKey',
        'title',
        'category',
        'trackingMode',
        'progressPercent',
        'currentValue',
        'targetValue',
        'unitLabel',
        'targetMinutes',
        'loggedMinutes',
        'subtasks',
        'reminderTime',
        'completedAt',
        'milestoneNotified',
        'createdAt',
        'updatedAt'
      ]) &&
      data.ownerId is string && data.ownerId == request.auth.uid && data.ownerId == userId && isValidId(data.ownerId) &&
      isValidDateKey(data.dateKey) &&
      data.title is string && data.title.size() >= 1 && data.title.size() <= 140 &&
      data.category in ['Work', 'Study', 'Health', 'Personal', 'Finance'] &&
      data.trackingMode in ['slider', 'counter', 'checklist', 'timer'] &&
      data.progressPercent is number && data.progressPercent >= 0 && data.progressPercent <= 100 &&
      data.currentValue is number && data.currentValue >= 0 && data.currentValue <= 100000 &&
      data.targetValue is number && data.targetValue >= 1 && data.targetValue <= 100000 &&
      data.unitLabel is string && data.unitLabel.size() <= 24 &&
      data.targetMinutes is number && data.targetMinutes >= 1 && data.targetMinutes <= 1440 &&
      data.loggedMinutes is number && data.loggedMinutes >= 0 && data.loggedMinutes <= 1440 &&
      data.subtasks is list && data.subtasks.size() <= 25 &&
      (data.subtasks.size() == 0 || data.subtasks[0] is map) &&
      (!('reminderTime' in data) || data.reminderTime == '' || isValidTimeHHMM(data.reminderTime)) &&
      (!('completedAt' in data) || (data.completedAt is string && data.completedAt.size() <= 40)) &&
      data.milestoneNotified is bool &&
      data.createdAt is timestamp &&
      data.updatedAt is timestamp;
    }

    function isValidSession(data, userId) {
      return data.keys().hasAll([
        'ownerId',
        'dateKey',
        'goalId',
        'goalTitle',
        'mode',
        'durationMinutes',
        'startedAt',
        'endedAt',
        'createdAt'
      ]) &&
      data.keys().hasOnly([
        'ownerId',
        'dateKey',
        'goalId',
        'goalTitle',
        'mode',
        'durationMinutes',
        'startedAt',
        'endedAt',
        'note',
        'createdAt'
      ]) &&
      data.ownerId is string && data.ownerId == request.auth.uid && data.ownerId == userId && isValidId(data.ownerId) &&
      isValidDateKey(data.dateKey) &&
      isValidId(data.goalId) &&
      data.goalTitle is string && data.goalTitle.size() >= 1 && data.goalTitle.size() <= 140 &&
      data.mode in ['pomodoro', 'deep', 'custom'] &&
      data.durationMinutes is number && data.durationMinutes >= 1 && data.durationMinutes <= 600 &&
      data.startedAt is string && data.startedAt.size() >= 1 && data.startedAt.size() <= 40 &&
      data.endedAt is string && data.endedAt.size() >= 1 && data.endedAt.size() <= 40 &&
      (!('note' in data) || (data.note is string && data.note.size() <= 240)) &&
      data.createdAt is timestamp;
    }

    function isValidExpense(data, userId) {
      return data.keys().hasAll([
        'ownerId',
        'dateKey',
        'amount',
        'category',
        'note',
        'createdAt',
        'updatedAt'
      ]) &&
      data.keys().hasOnly([
        'ownerId',
        'dateKey',
        'amount',
        'category',
        'note',
        'createdAt',
        'updatedAt'
      ]) &&
      data.ownerId is string && data.ownerId == request.auth.uid && data.ownerId == userId && isValidId(data.ownerId) &&
      isValidDateKey(data.dateKey) &&
      data.amount is number && data.amount > 0 && data.amount <= 10000000 &&
      data.category in ['Food', 'Transport', 'Work', 'Bills', 'Health', 'Personal'] &&
      data.note is string && data.note.size() >= 1 && data.note.size() <= 160 &&
      data.createdAt is timestamp &&
      data.updatedAt is timestamp;
    }

    function isValidNotification(data, userId) {
      return data.keys().hasAll([
        'ownerId',
        'type',
        'title',
        'body',
        'read',
        'triggeredAt',
        'createdAt',
        'updatedAt'
      ]) &&
      data.keys().hasOnly([
        'ownerId',
        'type',
        'title',
        'body',
        'read',
        'triggeredAt',
        'createdAt',
        'updatedAt'
      ]) &&
      data.ownerId is string && data.ownerId == request.auth.uid && data.ownerId == userId && isValidId(data.ownerId) &&
      data.type in ['reminder', 'milestone', 'budget_warning', 'budget_exceeded', 'timer'] &&
      data.title is string && data.title.size() >= 1 && data.title.size() <= 120 &&
      data.body is string && data.body.size() >= 1 && data.body.size() <= 320 &&
      data.read is bool &&
      data.triggeredAt is string && data.triggeredAt.size() >= 1 && data.triggeredAt.size() <= 40 &&
      data.createdAt is timestamp &&
      data.updatedAt is timestamp;
    }

    // --- Collection Rules ---
    match /users/{userId} {
      allow get: if isOwner(userId) && isValidId(userId);
      allow list: if false;

      allow create: if isVerifiedOwner(userId) &&
        isValidId(userId) &&
        isValidUserAccount(incoming(), userId) &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time;

      allow update: if isVerifiedOwner(userId) &&
        isValidId(userId) &&
        isValidUserAccount(incoming(), userId) &&
        incoming().uid == existing().uid &&
        incoming().createdAt == existing().createdAt &&
        incoming().updatedAt == request.time &&
        (
          incoming().diff(existing()).affectedKeys().hasOnly([
            'name',
            'role',
            'focusPillar',
            'dailyFocusTargetMinutes',
            'avatarStyle',
            'avatarColor',
            'onboardingCompleted',
            'themeMode',
            'currencySymbol',
            'dailyBudgetCap',
            'budgetWarningPercent',
            'dailyGoalSuccessThreshold',
            'notificationsEnabled',
            'morningReminderTime',
            'eveningReminderTime',
            'celebrateMilestones',
            'budgetWarningsEnabled',
            'updatedAt'
          ])
        );

      allow delete: if isVerifiedOwner(userId) && isValidId(userId);

      // Subcollection: Daily Goals
      match /goals/{goalId} {
        allow get: if isOwner(userId) && isValidId(userId) && isValidId(goalId) && existing().ownerId == request.auth.uid;
        allow list: if isOwner(userId) && existing().ownerId == request.auth.uid;

        allow create: if isVerifiedOwner(userId) &&
          isValidId(userId) &&
          isValidId(goalId) &&
          isValidGoal(incoming(), userId) &&
          incoming().createdAt == request.time &&
          incoming().updatedAt == request.time &&
          parentUserExists(userId);

        allow update: if isVerifiedOwner(userId) &&
          isValidId(userId) &&
          isValidId(goalId) &&
          isValidGoal(incoming(), userId) &&
          incoming().ownerId == existing().ownerId &&
          incoming().createdAt == existing().createdAt &&
          incoming().updatedAt == request.time &&
          parentUserExists(userId) &&
          (
            incoming().diff(existing()).affectedKeys().hasOnly([
              'title',
              'category',
              'trackingMode',
              'progressPercent',
              'currentValue',
              'targetValue',
              'unitLabel',
              'targetMinutes',
              'loggedMinutes',
              'subtasks',
              'reminderTime',
              'completedAt',
              'milestoneNotified',
              'updatedAt'
            ])
          );

        allow delete: if isVerifiedOwner(userId) && isValidId(userId) && isValidId(goalId) && existing().ownerId == request.auth.uid;
      }

      // Subcollection: Work Sessions (immutable log entries once recorded)
      match /sessions/{sessionId} {
        allow get: if isOwner(userId) && isValidId(userId) && isValidId(sessionId) && existing().ownerId == request.auth.uid;
        allow list: if isOwner(userId) && existing().ownerId == request.auth.uid;

        allow create: if isVerifiedOwner(userId) &&
          isValidId(userId) &&
          isValidId(sessionId) &&
          isValidSession(incoming(), userId) &&
          incoming().createdAt == request.time &&
          parentUserExists(userId);

        allow update: if false;

        allow delete: if isVerifiedOwner(userId) && isValidId(userId) && isValidId(sessionId) && existing().ownerId == request.auth.uid;
      }

      // Subcollection: Daily Expenses
      match /expenses/{expenseId} {
        allow get: if isOwner(userId) && isValidId(userId) && isValidId(expenseId) && existing().ownerId == request.auth.uid;
        allow list: if isOwner(userId) && existing().ownerId == request.auth.uid;

        allow create: if isVerifiedOwner(userId) &&
          isValidId(userId) &&
          isValidId(expenseId) &&
          isValidExpense(incoming(), userId) &&
          incoming().createdAt == request.time &&
          incoming().updatedAt == request.time &&
          parentUserExists(userId);

        allow update: if isVerifiedOwner(userId) &&
          isValidId(userId) &&
          isValidId(expenseId) &&
          isValidExpense(incoming(), userId) &&
          incoming().ownerId == existing().ownerId &&
          incoming().createdAt == existing().createdAt &&
          incoming().updatedAt == request.time &&
          parentUserExists(userId) &&
          (
            incoming().diff(existing()).affectedKeys().hasOnly([
              'amount',
              'category',
              'note',
              'updatedAt'
            ])
          );

        allow delete: if isVerifiedOwner(userId) && isValidId(userId) && isValidId(expenseId) && existing().ownerId == request.auth.uid;
      }

      // Subcollection: Notification History
      match /notifications/{notificationId} {
        allow get: if isOwner(userId) && isValidId(userId) && isValidId(notificationId) && existing().ownerId == request.auth.uid;
        allow list: if isOwner(userId) && existing().ownerId == request.auth.uid;

        allow create: if isVerifiedOwner(userId) &&
          isValidId(userId) &&
          isValidId(notificationId) &&
          isValidNotification(incoming(), userId) &&
          incoming().createdAt == request.time &&
          incoming().updatedAt == request.time &&
          parentUserExists(userId);

        allow update: if isVerifiedOwner(userId) &&
          isValidId(userId) &&
          isValidId(notificationId) &&
          isValidNotification(incoming(), userId) &&
          incoming().ownerId == existing().ownerId &&
          incoming().createdAt == existing().createdAt &&
          incoming().updatedAt == request.time &&
          parentUserExists(userId) &&
          (
            incoming().diff(existing()).affectedKeys().hasOnly(['read', 'updatedAt'])
          );

        allow delete: if isVerifiedOwner(userId) && isValidId(userId) && isValidId(notificationId) && existing().ownerId == request.auth.uid;
      }
    }
  }
}
